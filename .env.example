# LOCAL DEVELOPMENT ONLY. Use URL-safe characters because Compose builds DATABASE_URL.
POSTGRES_PASSWORD=local-only-change-me
# Shared local API/Web proof key: random 32-128 characters, never the development fallback.
# pnpm dev:docker generates an ephemeral key and reuses existing local DB credentials.
QRG_INTERNAL_PROXY_SECRET=
# Optional local admin MFA encryption key: canonical base64 of 32 random bytes.
# Empty prevents MFA enrollment and privileged admin access; bootstrap login stays restricted.
# Never commit a real key or enrollment secret.
ADMIN_MFA_ENCRYPTION_KEY=
# One-time bootstrap: inject real values from an operator secret manager; never commit them.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
# One-time operator authorization only; never enable by default.
ADMIN_INITIAL_PROMOTE_EXISTING=false
