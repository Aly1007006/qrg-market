# No secrets or database variables belong in the frontend.
NEXT_TELEMETRY_DISABLED=1
# Exact browser origin, identical to Nest APP_ORIGIN; configure HTTPS in production.
QRG_APP_ORIGIN=http://localhost:3000
# Opt-in preview only. Ignored in production, even when true.
QRG_DEV_FIXTURES=false
# Optional trusted HTTPS origin for canonical URLs. No inferred Host header.
QRG_SITE_URL=
# Enable only for the approved production launch with a real public API and HTTPS site origin.
QRG_INDEXING_ENABLED=false
# Server-only Nest origin. Empty disables live data; never a browser-supplied URL.
QRG_API_ORIGIN=http://127.0.0.1:3001
# Optional trusted HTTPS public S3/CDN origin; set at build and runtime.
# Only processed products/<product UUID>/<random UUID>.webp or .avif objects.
QRG_MEDIA_ORIGIN=
