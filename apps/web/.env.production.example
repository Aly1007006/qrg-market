# Public, non-secret production settings only. Replace example.invalid at deploy time.
NEXT_TELEMETRY_DISABLED=1
QRG_APP_ORIGIN=https://qrg.example.invalid
# Enable only after the real origin is HTTPS and externally verified. Deliberately
# excludes includeSubDomains/preload because those commitments are not proven.
QRG_HSTS_ENABLED=false
QRG_SITE_URL=https://qrg.example.invalid
# Keep indexing disabled until the real domain, TLS and public-data checks are verified.
QRG_INDEXING_ENABLED=false
# Private origin reachable by Next.js only; never expose the Nest port publicly.
QRG_API_ORIGIN=http://127.0.0.1:3001
# Trusted HTTPS media delivery origin. The storage bucket itself remains private.
QRG_MEDIA_ORIGIN=https://media.qrg.example.invalid
QRG_DEV_FIXTURES=false
# Same secret as API INTERNAL_PROXY_SECRET; server-side only.
QRG_INTERNAL_PROXY_SECRET=
