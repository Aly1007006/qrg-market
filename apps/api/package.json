{
  "name": "@qrg/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:admin-control": "tsc -p tsconfig.test.json && node --test .test-dist/test/admin-control.integration.test.js",
    "admin:bootstrap": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/admin/bootstrap-main.js",
    "test:operations": "tsc -p tsconfig.test.json && node --test .test-dist/test/seller-operations.integration.test.js",
    "test:analytics": "tsc -p tsconfig.test.json && node --test .test-dist/test/analytics.integration.test.js",
    "test:payments": "tsc -p tsconfig.test.json && node --test .test-dist/test/halyk.integration.test.js",
    "test:subscriptions": "tsc -p tsconfig.test.json && node --test .test-dist/test/subscriptions.integration.test.js",
    "billing:tick": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/subscriptions/tick-main.js",
    "admin:provision": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/admin/provision-main.js",
    "test:admin": "tsc -p tsconfig.test.json && node --test .test-dist/test/admin.integration.test.js",
    "test:requests": "tsc -p tsconfig.test.json && node --test .test-dist/test/requests.integration.test.js",
    "test:media": "tsc -p tsconfig.test.json && node --test .test-dist/test/media.integration.test.js",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=.env dist/main.js\"",
    "media:cleanup": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/media/cleanup-main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/config.test.js .test-dist/test/http.test.js .test-dist/test/auth.unit.test.js .test-dist/test/catalogue.unit.test.js .test-dist/test/media.unit.test.js .test-dist/test/requests.unit.test.js .test-dist/test/admin.unit.test.js .test-dist/test/subscriptions.unit.test.js .test-dist/test/halyk.unit.test.js .test-dist/test/halyk.commands.test.js .test-dist/test/operations.unit.test.js",
    "test:db": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env.test --test --test-concurrency=1 .test-dist/test/database.integration.test.js .test-dist/test/auth.integration.test.js .test-dist/test/catalogue.integration.test.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/db/migrate-main.js",
    "db:cleanup": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/db/cleanup-main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "drizzle-orm": "0.45.2",
    "express": "^5.1.0",
    "helmet": "8.3.0",
    "otpauth": "9.5.2",
    "pg": "8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "0.31.10",
    "tsc-watch": "^7.2.0"
  }
}
