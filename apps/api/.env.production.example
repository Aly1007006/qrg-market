NODE_ENV=production
# Read-only integration until callback signature specification/merchant acceptance.
# Never put sandbox credentials here; inject merchant values through Lockbox.
HALYK_ENVIRONMENT=disabled
HALYK_TERMINAL_ID=
HALYK_CLIENT_ID=
HALYK_CLIENT_SECRET=
# Distinct 32-byte base64 encryption key for mandatory admin TOTP; inject via Lockbox.
ADMIN_MFA_ENCRYPTION_KEY=
# Keep disabled until operator/privacy contacts, retention and KZ infrastructure are approved.
CUSTOMER_REQUESTS_ENABLED=false
# true fails closed until a real CAPTCHA verification adapter is configured.
REQUEST_CAPTCHA_REQUIRED=false
PORT=3001
# Inject via secret manager. Configure trusted private CA via NODE_EXTRA_CA_CERTS if needed.
DATABASE_URL=postgresql://runtime_user:REPLACE_VIA_SECRET_MANAGER@private-db.example.invalid:5432/qrg_market
DATABASE_SSL=true
SWAGGER_ENABLED=false
APP_ORIGIN=https://qrg.example.invalid
# Inject a random 32+ character secret from the secret manager.
AUTH_RATE_LIMIT_SECRET=
