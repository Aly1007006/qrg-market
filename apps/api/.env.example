NODE_ENV=development
# PHASE 7B partial: read-only Halyk status client. Credentials DO NOT enable payments.
# Callback signature contract and merchant acceptance remain required.
HALYK_ENVIRONMENT=disabled
HALYK_TERMINAL_ID=
HALYK_CLIENT_ID=
HALYK_CLIENT_SECRET=
# Base64-encoded 32 random bytes via secret manager. No default administrator/key.
ADMIN_MFA_ENCRYPTION_KEY=
CUSTOMER_REQUESTS_ENABLED=true
# Enable only after selecting and configuring a real CAPTCHA adapter. Otherwise fails closed.
REQUEST_CAPTCHA_REQUIRED=false
PORT=3001
# Local-only example; use a dedicated runtime DB role in production.
DATABASE_URL=postgresql://qrg_local:local-only-change-me@127.0.0.1:5432/qrg_market
DATABASE_SSL=false
SWAGGER_ENABLED=true
APP_ORIGIN=http://localhost:3000
AUTH_RATE_LIMIT_SECRET=local-development-rate-limit-key-not-for-production
# Local Docker S3 only. Production: private KZ bucket, HTTPS, least-privilege secrets.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=qrg-local-images
S3_ACCESS_KEY_ID=qrg-local-only
S3_SECRET_ACCESS_KEY=local-storage-only-change-me
S3_FORCE_PATH_STYLE=true
